<Window x:Class="DinoTranslator.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalação do DinoTranslator"
        Width="640" Height="460" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Tinta}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="2" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <Border Width="22" Height="22" Background="{StaticResource Ipe}">
          <TextBlock Text="DT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinta}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Instalação do DinoTranslator" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>
      <!-- O ícone leva a fonte junto: o estilo padrão de TextBlock trocaria pela Segoe UI. -->
      <Button x:Name="CloseButton" Style="{StaticResource Fechar}" HorizontalAlignment="Right"
              WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Fechar">
        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Papel2}" />
      </Button>
    </Grid>

    <!-- Faixa ipê e Gzhel: as duas pessoas da chamada. -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Background="{StaticResource Ipe}" />
      <Border Grid.Column="1" Background="{StaticResource Gzhel}" />
    </Grid>

    <Grid Grid.Row="2" Margin="48,32,48,32">

      <!-- Boas-vindas -->
      <DockPanel x:Name="WelcomePanel">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock x:Name="Heading" FontSize="26" FontWeight="SemiBold" Text="Instalar o DinoTranslator" />
          <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Papel2}"
                     Text="Chamada de vídeo com tradução simultânea em texto entre duas pessoas." />

          <TextBlock Margin="0,28,0,6" FontSize="12" Foreground="{StaticResource Papel2}" Text="PASTA DA INSTALAÇÃO" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Botao}" Content="Alterar…" Margin="12,0,0,0" Click="OnChooseFolder" />
            <Border Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linha}" BorderThickness="1" Padding="12,0">
              <TextBlock x:Name="FolderText" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Border>
          </DockPanel>

          <CheckBox x:Name="DesktopShortcut" Margin="0,16,0,0" IsChecked="True" Content="Criar atalho na área de trabalho" />

          <Border x:Name="WebView2Notice" Visibility="Collapsed" Margin="0,16,0,0" Padding="12,8"
                  BorderBrush="{StaticResource Ipe}" BorderThickness="2,0,0,0" Background="{StaticResource Superficie}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Botao}" Content="Baixar WebView2" Margin="12,0,0,0" Click="OnGetWebView2" />
              <TextBlock FontSize="13" Text="Este Windows não tem o WebView2 Runtime, que o app precisa. Instale-o pelo site da Microsoft." />
            </DockPanel>
          </Border>

          <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,16,0,0" Foreground="{StaticResource Erro}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Style="{StaticResource Botao}" Content="Cancelar" Margin="0,0,12,0" Click="OnClose" />
          <Button x:Name="InstallButton" Style="{StaticResource BotaoPrincipal}" Content="Instalar" MinWidth="140" Click="OnInstall" />
        </StackPanel>
      </DockPanel>

      <!-- Progresso -->
      <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
        <TextBlock FontSize="26" FontWeight="SemiBold" Text="Instalando…" />
        <ProgressBar x:Name="Progress" Margin="0,24,0,0" Minimum="0" Maximum="100" />
        <TextBlock x:Name="ProgressText" Margin="0,10,0,0" FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Papel2}" />
      </StackPanel>

      <!-- Concluído -->
      <DockPanel x:Name="DonePanel" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock FontSize="26" FontWeight="SemiBold" Text="Pronto." />
          <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Papel2}"
                     Text="O DinoTranslator está no menu Iniciar. Para remover, use Configurações › Aplicativos › Aplicativos instalados." />
          <CheckBox x:Name="OpenNow" Margin="0,24,0,0" IsChecked="True" Content="Abrir o DinoTranslator agora" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource BotaoPrincipal}" Content="Concluir" MinWidth="140"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnFinish" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
