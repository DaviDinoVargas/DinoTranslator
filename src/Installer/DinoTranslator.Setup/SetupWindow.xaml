<Window x:Class="DinoTranslator.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalação do DinoTranslator"
        Width="560" Height="580" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Tinta}" Foreground="{StaticResource Papel}" Icon="DinoTranslator.ico">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <!-- Papel de parede do app. -->
    <Rectangle Fill="{StaticResource Fundo}" />
    <Rectangle Fill="{StaticResource BrilhoDourado}" />
    <Rectangle Fill="{StaticResource BrilhoAzul}" />

    <Button x:Name="CloseButton" Style="{StaticResource Fechar}" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,12,12,0" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Fechar">
      <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Papel2}" />
    </Button>

    <Grid Margin="44,40,44,32">

      <!-- Boas-vindas -->
      <DockPanel x:Name="WelcomePanel">
        <StackPanel DockPanel.Dock="Top">
          <Image Source="DinoTranslator.png" Width="84" Height="84" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.Effect>
              <DropShadowEffect Color="#0A84FF" BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.45" />
            </Image.Effect>
          </Image>
          <TextBlock x:Name="Heading" Margin="0,18,0,0" FontFamily="{StaticResource FonteTitulo}" FontSize="25" FontWeight="Bold"
                     TextAlignment="Center" Text="Instalar o DinoTranslator" />
          <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Papel2}" TextAlignment="Center"
                     Text="Videochamada com tradução simultânea, direto entre os dois computadores." />

          <!-- Cartão de vidro com a pasta e o atalho. -->
          <Border Margin="0,22,0,0" Padding="16,12" CornerRadius="18" Background="{StaticResource Vidro}"
                  BorderBrush="{StaticResource VidroBorda}" BorderThickness="1">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource BotaoTexto}" Content="Alterar…" Click="OnChooseFolder" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock FontSize="12" Foreground="{StaticResource Papel2}" Text="Pasta da instalação" />
                  <TextBlock x:Name="FolderText" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,2,0,0"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
              </DockPanel>
              <Border Height="1" Margin="0,12" Background="{StaticResource Vidro}" />
              <CheckBox x:Name="DesktopShortcut" IsChecked="True" Content="Criar atalho na área de trabalho" />
              <CheckBox x:Name="ExtrasCheck" IsChecked="True" Margin="0,10,0,0">
                <TextBlock x:Name="ExtrasText" TextWrapping="Wrap" Text="Instalar os motores e modelos de tradução" />
              </CheckBox>
            </StackPanel>
          </Border>

          <Border x:Name="WebView2Notice" Visibility="Collapsed" Margin="0,12,0,0" Padding="14,10" CornerRadius="14"
                  Background="#24FF9F0A" BorderBrush="#40FF9F0A" BorderThickness="1">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource BotaoTexto}" Content="Baixar WebView2" Click="OnGetWebView2" />
              <TextBlock FontSize="13" VerticalAlignment="Center"
                         Text="Este Windows não tem o WebView2 Runtime, que o app precisa. Instale pelo site da Microsoft." />
            </DockPanel>
          </Border>

          <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,12,0,0" Foreground="#FFB4AE" TextAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Button x:Name="InstallButton" Style="{StaticResource BotaoPrincipal}" Content="Instalar" Click="OnInstall" />
          <Button Style="{StaticResource BotaoTexto}" Content="Cancelar" Margin="0,8,0,0" HorizontalAlignment="Center" Click="OnClose" />
        </StackPanel>
      </DockPanel>

      <!-- Progresso -->
      <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center">
        <Image Source="DinoTranslator.png" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock x:Name="ProgressHeading" Margin="0,18,0,0" FontFamily="{StaticResource FonteTitulo}" FontSize="22" FontWeight="Bold"
                   TextAlignment="Center" Text="Instalando…" />
        <ProgressBar x:Name="Progress" Margin="24,22,24,0" Minimum="0" Maximum="100" />
        <TextBlock x:Name="ProgressText" Margin="0,10,0,0" FontSize="12" Foreground="{StaticResource Papel2}"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </StackPanel>

      <!-- Concluído -->
      <DockPanel x:Name="DonePanel" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,24,0,0">
          <Grid Width="84" Height="84">
            <Ellipse Fill="#2630D158" />
            <Path Data="M24 43 36 55 60 30" Stroke="#30D158" StrokeThickness="6" StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" StrokeLineJoin="Round" />
          </Grid>
          <TextBlock Margin="0,18,0,0" FontFamily="{StaticResource FonteTitulo}" FontSize="25" FontWeight="Bold"
                     TextAlignment="Center" Text="Tudo pronto" />
          <TextBlock Margin="0,6,0,0" Foreground="{StaticResource Papel2}" TextAlignment="Center"
                     Text="O DinoTranslator está no menu Iniciar. Para remover, abra o Desinstalar.exe na pasta do app ou use Configurações › Aplicativos › Aplicativos instalados." />
          <TextBlock x:Name="ExtrasNote" Visibility="Collapsed" Margin="0,14,0,0" Foreground="#FFD9B0" TextAlignment="Center" />
          <CheckBox x:Name="OpenNow" Margin="0,22,0,0" HorizontalAlignment="Center" IsChecked="True" Content="Abrir o DinoTranslator agora" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource BotaoPrincipal}" Content="Concluir" VerticalAlignment="Bottom" Click="OnFinish" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
