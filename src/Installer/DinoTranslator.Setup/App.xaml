<Application x:Class="DinoTranslator.Setup.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="Tinta" Color="#12110F" />
    <SolidColorBrush x:Key="Superficie" Color="#1B1916" />
    <SolidColorBrush x:Key="Superficie2" Color="#24211D" />
    <SolidColorBrush x:Key="Linha" Color="#34302A" />
    <SolidColorBrush x:Key="Papel" Color="#F1ECE2" />
    <SolidColorBrush x:Key="Papel2" Color="#A8A091" />
    <SolidColorBrush x:Key="Ipe" Color="#F2B705" />
    <SolidColorBrush x:Key="Gzhel" Color="#3D6FE0" />
    <SolidColorBrush x:Key="Erro" Color="#D9534F" />

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Papel}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Botao" TargetType="Button">
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Foreground" Value="{StaticResource Papel}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="Opacity" Value="0.85" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Fundo" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BotaoPrincipal" TargetType="Button" BasedOn="{StaticResource Botao}">
      <Setter Property="Background" Value="{StaticResource Ipe}" />
      <Setter Property="BorderBrush" Value="{StaticResource Ipe}" />
      <Setter Property="Foreground" Value="{StaticResource Tinta}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Papel2}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,6" />
    </Style>

    <Style x:Key="Fechar" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Foreground" Value="{StaticResource Papel2}" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource Erro}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Height" Value="6" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" Background="{StaticResource Superficie2}" />
              <Border x:Name="PART_Indicator" Background="{StaticResource Ipe}" HorizontalAlignment="Left" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Application.Resources>
</Application>
