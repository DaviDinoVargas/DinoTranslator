<Window x:Class="DinoTranslator.Desktop.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desinstalar o DinoTranslator"
        Width="600" Height="400" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Tinta}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Papel}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Botao" TargetType="Button">
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Padding" Value="20,0" />
      <Setter Property="Foreground" Value="{StaticResource Papel}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="Opacity" Value="0.85" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BotaoRemover" TargetType="Button" BasedOn="{StaticResource Botao}">
      <Setter Property="Background" Value="{StaticResource Erro}" />
      <Setter Property="BorderBrush" Value="{StaticResource Erro}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="2" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
        <Border Width="22" Height="22" Background="{StaticResource Ipe}">
          <TextBlock Text="DT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinta}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <TextBlock Text="Desinstalar o DinoTranslator" Margin="10,0,0,0" FontSize="13" VerticalAlignment="Center" />
      </StackPanel>
      <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
              WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Fechar" />
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource Erro}" />

    <Grid Grid.Row="2" Margin="48,32,48,32">
      <DockPanel x:Name="ConfirmPanel">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock FontSize="26" FontWeight="SemiBold" Text="Remover o DinoTranslator?" />
          <TextBlock x:Name="Message" Margin="0,8,0,0" Foreground="{StaticResource Papel2}"
                     Text="O app, os atalhos e o registro em Aplicativos instalados serão removidos." />
          <CheckBox x:Name="DeleteData" Margin="0,24,0,0" Foreground="{StaticResource Papel2}" FontSize="14">
            <TextBlock Foreground="{StaticResource Papel2}"
                       Text="Apagar também meus dados neste computador: perfil, chave de tradução, histórico e modelos baixados." />
          </CheckBox>
          <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,16,0,0" Foreground="{StaticResource Erro}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
          <Button Style="{StaticResource Botao}" Content="Cancelar" Margin="0,0,12,0" Click="OnClose" />
          <Button x:Name="RemoveButton" Style="{StaticResource BotaoRemover}" Content="Desinstalar" Click="OnUninstall" />
        </StackPanel>
      </DockPanel>

      <DockPanel x:Name="DonePanel" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock FontSize="26" FontWeight="SemiBold" Text="Desinstalado." />
          <TextBlock Margin="0,8,0,0" Foreground="{StaticResource Papel2}"
                     Text="A pasta do app é apagada assim que esta janela fechar." />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource Botao}" Content="Fechar"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="OnClose" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
