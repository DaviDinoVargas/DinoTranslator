<Window x:Class="DinoTranslator.Desktop.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desinstalar o DinoTranslator"
        Width="520" Height="500" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Tinta}" Icon="Assets/DinoTranslator.ico">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <FontFamily x:Key="Fonte">Segoe UI Variable Text, Segoe UI</FontFamily>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Papel}" />
      <Setter Property="FontFamily" Value="{StaticResource Fonte}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Botao" TargetType="Button">
      <Setter Property="Height" Value="46" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontFamily" Value="{StaticResource Fonte}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF5D54" Offset="0" />
            <GradientStop Color="#FF453A" Offset="1" />
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="23" BorderThickness="1" BorderBrush="#26FFFFFF">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="Opacity" Value="0.88" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BotaoTexto" TargetType="Button" BasedOn="{StaticResource Botao}">
      <Setter Property="Height" Value="38" />
      <Setter Property="Foreground" Value="#409CFF" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" Background="Transparent" CornerRadius="19" Padding="16,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="Background" Value="#1F0A84FF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fechar" TargetType="Button">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fundo" Background="{StaticResource Vidro}" CornerRadius="16">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Fundo" Property="Background" Value="{StaticResource VidroBorda}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- Papel de parede do app. -->
    <Rectangle>
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#0B1124" Offset="0" />
          <GradientStop Color="#060912" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle>
      <Rectangle.Fill>
        <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="1" RadiusY="0.9">
          <GradientStop Color="#503D6FE0" Offset="0" />
          <GradientStop Color="#003D6FE0" Offset="1" />
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <Button Style="{StaticResource Fechar}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
            WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Fechar">
      <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Foreground="{StaticResource Papel2}" />
    </Button>

    <Grid Margin="44,44,44,30">
      <DockPanel x:Name="ConfirmPanel">
        <StackPanel DockPanel.Dock="Top">
          <Image Source="Assets/DinoTranslator.png" Width="76" Height="76" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Margin="0,18,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Bold"
                     TextAlignment="Center" Text="Remover o DinoTranslator?" />
          <TextBlock x:Name="Message" Margin="0,6,0,0" Foreground="{StaticResource Papel2}" TextAlignment="Center"
                     Text="O app, os atalhos e o registro em Aplicativos instalados serão removidos." />
          <Border Margin="0,22,0,0" Padding="16,14" CornerRadius="18" Background="{StaticResource Vidro}"
                  BorderBrush="{StaticResource VidroBorda}" BorderThickness="1">
            <CheckBox x:Name="DeleteData" Cursor="Hand">
              <TextBlock Foreground="{StaticResource Papel}" FontSize="13.5"
                         Text="Apagar também meus dados neste computador: perfil, chave de tradução, histórico e modelos baixados." />
            </CheckBox>
          </Border>
          <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="0,12,0,0" Foreground="#FFB4AE" TextAlignment="Center" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
          <Button x:Name="RemoveButton" Style="{StaticResource Botao}" Content="Desinstalar" Click="OnUninstall" />
          <Button Style="{StaticResource BotaoTexto}" Content="Cancelar" Margin="0,8,0,0" HorizontalAlignment="Center" Click="OnClose" />
        </StackPanel>
      </DockPanel>

      <DockPanel x:Name="DonePanel" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="0,30,0,0">
          <Image Source="Assets/DinoTranslator.png" Width="76" Height="76" Opacity="0.6" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Margin="0,18,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="24" FontWeight="Bold"
                     TextAlignment="Center" Text="Desinstalado" />
          <TextBlock x:Name="DoneText" Margin="0,6,0,0" Foreground="{StaticResource Papel2}" TextAlignment="Center" TextWrapping="Wrap"
                     Text="A pasta do app é apagada assim que esta janela fechar." />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource BotaoTexto}" Content="Fechar" VerticalAlignment="Bottom"
                HorizontalAlignment="Center" Click="OnClose" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
