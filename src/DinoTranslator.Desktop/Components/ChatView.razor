@using DinoTranslator.Desktop.Services.Plus
@using DinoTranslator.Shared.Social
@implements IDisposable
@inject PlusState State
@inject DirectCalls Calls
@inject PlusGlossary Glossaries
@inject IJSRuntime Js

@* Um canal de texto ou uma conversa direta. Cada mensagem aparece no idioma de quem lê
   (traduzida neste computador), com o original embaixo; reações, respostas citando, menções em
   destaque, mensagens fixadas e busca. *@
<div class="chat" data-canal="@Channel.Id">
  <header class="chat__head">
    <p class="chat__title">@Title</p>
    <form class="chat__search" @onsubmit="SearchAsync" role="search">
      <input class="field__input" @bind="_query" placeholder="Buscar" aria-label="Buscar mensagens" maxlength="@SocialLimits.MaxSearchLength" />
    </form>
    @if (Channel.Kind == ChannelKind.Direct)
    {
      <button type="button" class="icon-button" title="Ligar" aria-label="Ligar para @Title" disabled="@Calls.Busy"
              @onclick="() => Calls.CallAsync(Channel.Id)"><Icon Name="telefone" /></button>
    }
    <button type="button" class="icon-button @(_pins is not null ? "icon-button--on" : "")" title="Mensagens fixadas" aria-label="Mensagens fixadas"
            aria-pressed="@(_pins is not null ? "true" : "false")" @onclick="TogglePinsAsync"><Icon Name="fixar" /></button>
  </header>
  @if (!State.Translator.Available)
  {
    <p class="chat__note chat__note--bar"><Icon Name="info" />@(State.Translator.Problem ?? "Sem tradução neste computador.") As mensagens aparecem no original.</p>
  }

  @if (_results is not null)
  {
    <div class="chat__panel" aria-label="Resultado da busca">
      <p class="chat__panel-title">
        @(_results.Count == 0 ? "Nada encontrado" : $"{_results.Count} resultado(s)") para “@_searched”
        <button type="button" class="icon-button" aria-label="Fechar a busca" @onclick="() => _results = null"><Icon Name="fechar" /></button>
      </p>
      <ol class="chat__list chat__list--panel">
        @foreach (var result in _results)
        {
          <li class="chat-message chat-message--result">
            <Avatar Name="@result.Message.Author.DisplayName" Class="avatar--small" />
            <div class="chat-message__body">
              <p class="chat-message__meta"><span class="chat-message__author">@result.Message.Author.DisplayName</span> <span>@result.ChannelName</span>
                <time>@result.Message.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</time></p>
              <p class="chat-message__text">@TextFor(result.Message)</p>
            </div>
          </li>
        }
      </ol>
    </div>
  }
  else if (_pins is not null)
  {
    <div class="chat__panel" aria-label="Mensagens fixadas">
      <p class="chat__panel-title">
        @(_pins.Count == 0 ? "Nenhuma mensagem fixada" : $"{_pins.Count} fixada(s)")
        <button type="button" class="icon-button" aria-label="Fechar as fixadas" @onclick="() => _pins = null"><Icon Name="fechar" /></button>
      </p>
      <ol class="chat__list chat__list--panel">
        @foreach (var pinned in _pins)
        {
          <li class="chat-message chat-message--result">
            <Avatar Name="@pinned.Author.DisplayName" Class="avatar--small" />
            <div class="chat-message__body">
              <p class="chat-message__meta"><span class="chat-message__author">@pinned.Author.DisplayName</span> <time>@pinned.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</time></p>
              <p class="chat-message__text">@TextFor(pinned)</p>
            </div>
          </li>
        }
      </ol>
    </div>
  }

  <ol class="chat__list" @ref="_list" aria-live="polite">
    @if (Messages.HasMore && Messages.Loaded)
    {
      <li class="chat__more"><button type="button" class="button button--quiet button--small" @onclick="() => State.LoadOlderAsync(Channel.Id)">Mensagens anteriores</button></li>
    }
    @foreach (var message in Messages.Items)
    {
      var mine = message.Author.Id == State.Me?.Id;
      var translated = mine || message.Deleted || Glossary is not { } glossary ? null : State.Translator.Get(message.Id, message.EditedAt, message.Content, message.Language, MyLanguage, glossary);
      var pending = !mine && !message.Deleted && translated is null && message.Language != MyLanguage && State.Translator.Available;
      <li class="chat-message @(mine ? "chat-message--mine" : "") @(State.MentionsMe(message) ? "chat-message--mention" : "") @(message.Pinned ? "chat-message--pinned" : "")" data-id="@message.Id">
        <Avatar Name="@message.Author.DisplayName" Mine="mine" Class="avatar--small" />
        <div class="chat-message__body">
          @if (message.Reply is { } quote)
          {
            <p class="chat-message__quote"><span class="chat-message__quote-author">@quote.AuthorName</span> @(quote.Deleted ? "mensagem apagada" : QuoteText(quote))</p>
          }
          <p class="chat-message__meta">
            <span class="chat-message__author">@message.Author.DisplayName</span>
            <time>@message.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</time>
            @if (message.EditedAt is not null && !message.Deleted)
            {
              <span>· editada</span>
            }
            @if (message.Pinned)
            {
              <span class="chat-message__pin"><Icon Name="fixar" Class="icon--inline" />fixada</span>
            }
          </p>
          @if (message.Deleted)
          {
            <p class="chat-message__deleted">Mensagem apagada.</p>
          }
          else if (_editing == message.Id)
          {
            <form class="chat-message__edit" @onsubmit="() => SaveEditAsync(message)">
              <input class="field__input" @bind="_editText" aria-label="Editar a mensagem" maxlength="@SocialLimits.MaxMessageLength" />
              <button type="submit" class="icon-button icon-button--ok" aria-label="Salvar"><Icon Name="ok" /></button>
              <button type="button" class="icon-button" aria-label="Cancelar" @onclick="() => _editing = null"><Icon Name="fechar" /></button>
            </form>
          }
          else
          {
            <p class="chat-message__text">@(translated ?? message.Content)</p>
            @if (translated is not null)
            {
              <p class="chat-message__original">@LanguageTag(message.Language) @message.Content</p>
            }
            else if (pending)
            {
              <p class="chat-message__original">traduzindo…</p>
            }
          }
          @if (message.Reactions is { Count: > 0 } reactions)
          {
            <div class="reactions" role="group" aria-label="Reações">
              @foreach (var reaction in reactions)
              {
                var reacted = State.Me is { } me && reaction.Users.Contains(me.Id);
                <button type="button" class="reaction @(reacted ? "reaction--mine" : "")" aria-pressed="@(reacted ? "true" : "false")"
                        aria-label="@($"{reaction.Emoji} {reaction.Users.Count}")" title="@Names(reaction.Users)" @onclick="() => ReactAsync(message, reaction.Emoji)">
                  @reaction.Emoji <span>@reaction.Users.Count</span>
                </button>
              }
            </div>
          }
          @if (_reacting == message.Id)
          {
            <div class="reactions reactions--picker" role="group" aria-label="Escolher reação">
              @foreach (var emoji in SocialLimits.Reactions)
              {
                <button type="button" class="reaction" aria-label="@($"Reagir com {emoji}")" @onclick="() => ReactAsync(message, emoji)">@emoji</button>
              }
            </div>
          }
        </div>
        @if (!message.Deleted && _editing != message.Id)
        {
          <div class="chat-message__actions">
            <button type="button" class="icon-button" title="Reagir" aria-label="Reagir à mensagem" @onclick="() => _reacting = _reacting == message.Id ? null : message.Id"><Icon Name="reagir" /></button>
            <button type="button" class="icon-button" title="Responder" aria-label="Responder à mensagem" @onclick="() => _replyTo = message"><Icon Name="responder" /></button>
            @if (State.CanPin(Channel.Id))
            {
              <button type="button" class="icon-button" title="@(message.Pinned ? "Soltar" : "Fixar")" aria-label="@(message.Pinned ? "Soltar a mensagem" : "Fixar a mensagem")"
                      @onclick="() => PinAsync(message)"><Icon Name="fixar" /></button>
            }
            @if (mine)
            {
              <button type="button" class="icon-button" title="Editar" aria-label="Editar a mensagem" @onclick="() => StartEdit(message)"><Icon Name="editar" /></button>
              <button type="button" class="icon-button" title="Apagar" aria-label="Apagar a mensagem" @onclick="() => DeleteAsync(message)"><Icon Name="lixeira" /></button>
            }
          </div>
        }
      </li>
    }
    @if (Messages.Loaded && Messages.Items.Count == 0)
    {
      <li class="plus__empty">Nenhuma mensagem ainda. Escreva no seu idioma: cada pessoa lê no dela. Use @@usuário para chamar alguém.</li>
    }
  </ol>

  @if (Typers is { Length: > 0 } typers)
  {
    <p class="chat__typing">@typers digitando…</p>
  }
  @if (_error is not null)
  {
    <p class="login__error" role="alert"><Icon Name="alerta" />@_error</p>
  }
  @if (_replyTo is { } replying)
  {
    <div class="chat__replying">
      <Icon Name="responder" Class="icon--inline" />Respondendo a <strong>@replying.Author.DisplayName</strong>: <span>@Shorten(TextFor(replying))</span>
      <button type="button" class="icon-button" aria-label="Cancelar a resposta" @onclick="() => _replyTo = null"><Icon Name="fechar" /></button>
    </div>
  }
  <form class="composer chat__composer" @onsubmit="SendAsync">
    <input class="composer__input" type="text" @bind="_draft" @bind:event="oninput" @bind:after="TypedAsync" maxlength="@SocialLimits.MaxMessageLength"
           placeholder="@($"Mensagem em {LanguageName(MyLanguage)}")" aria-label="Escrever mensagem" autocomplete="off" />
    <button type="submit" class="composer__send" disabled="@(_sending || string.IsNullOrWhiteSpace(_draft))" aria-label="Enviar" title="Enviar">
      <Icon Name="enviar" />
    </button>
  </form>
</div>

@code {
    private ElementReference _list;
    private string _draft = "";
    private string _editText = "";
    private string _query = "";
    private string _searched = "";
    private long? _editing;
    private long? _reacting;
    private MessageInfo? _replyTo;
    private List<SearchResult>? _results;
    private List<MessageInfo>? _pins;
    private bool _sending;
    private string? _error;
    private long _lastShown;

    [Parameter, EditorRequired]
    public ChannelInfo Channel { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "";

    private ChannelMessages Messages => State.Messages(Channel.Id);

    private string MyLanguage => State.Me?.Language ?? Languages.PortugueseBrazil;

    private string? Typers => string.Join(", ", State.Typing(Channel.Id).Select(id => State.FindUser(id)?.DisplayName ?? "Alguém")) is { Length: > 0 } names ? names : null;

    private static string LanguageName(string code) => Languages.IsSupported(code) ? Languages.Get(code).NativeName : code;

    private static string LanguageTag(string code) => $"[{code}]";

    private static string Shorten(string text) => text.Length <= 120 ? text : text[..120] + "…";

    /// <summary>O texto no idioma de quem lê, se a tradução já estiver pronta; senão, o original.</summary>
    private string TextFor(MessageInfo message) =>
        message.Deleted ? "Mensagem apagada." :
        message.Author.Id == State.Me?.Id ? message.Content :
        (Glossary is { } glossary ? State.Translator.Get(message.Id, message.EditedAt, message.Content, message.Language, MyLanguage, glossary) : null) ?? message.Content;

    // A citação é traduzida como uma mensagem à parte (id negativo, para não misturar com a original no cache).
    private string QuoteText(MessageQuote quote) =>
        (Glossary is { } glossary ? State.Translator.Get(-quote.Id, null, quote.Content, quote.Language, MyLanguage, glossary) : null) ?? quote.Content;

    /// <summary>O glossário desta conversa (o do grupo com o pessoal por cima); null enquanto carrega.</summary>
    private DinoTranslator.Desktop.Services.Translation.Glossary? Glossary => Glossaries.For(Channel.GroupId);

    private string Names(IReadOnlyList<Guid> users) =>
        string.Join(", ", users.Select(id => id == State.Me?.Id ? "você" : State.FindUser(id)?.DisplayName ?? "alguém"));

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Calls.Changed += OnChanged;
        Glossaries.Changed += OnChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Mensagem nova embaixo: rola até ela.
        var last = Messages.Items.LastOrDefault()?.Id ?? 0;
        if (last != _lastShown)
        {
            _lastShown = last;
            await Js.InvokeVoidAsync("dinoScrollToEnd", _list);
        }
    }

    private Task TypedAsync() => State.TypingAsync(Channel.Id);

    private async Task SendAsync()
    {
        var text = _draft.Trim();
        if (text.Length == 0 || _sending)
        {
            return;
        }
        _sending = true;
        _error = await State.SendAsync(Channel.Id, text, _replyTo?.Id);
        if (_error is null)
        {
            _draft = "";
            _replyTo = null;
        }
        _sending = false;
    }

    private async Task ReactAsync(MessageInfo message, string emoji)
    {
        _reacting = null;
        // A versão mais nova da mensagem (as reações podem ter mudado desde o desenho).
        var current = Messages.Items.FirstOrDefault(m => m.Id == message.Id) ?? message;
        _error = await State.ToggleReactionAsync(current, emoji);
    }

    private async Task PinAsync(MessageInfo message)
    {
        _error = await State.PinAsync(message, !message.Pinned);
        if (_error is null && _pins is not null)
        {
            _pins = (await State.PinsAsync(Channel.Id)).Value ?? _pins;
        }
    }

    private async Task TogglePinsAsync()
    {
        if (_pins is not null)
        {
            _pins = null;
            return;
        }
        _results = null;
        var pins = await State.PinsAsync(Channel.Id);
        _pins = pins.Value;
        _error = pins.Error;
    }

    private async Task SearchAsync()
    {
        var query = _query.Trim();
        if (query.Length < SocialLimits.MinSearchLength)
        {
            _results = null;
            return;
        }
        _pins = null;
        // Num grupo, busca em todos os canais dele; na conversa direta, só nela.
        var found = Channel.GroupId is { } group
            ? await State.SearchAsync(query, null, group)
            : await State.SearchAsync(query, Channel.Id, null);
        _searched = query;
        _results = found.Value ?? [];
        _error = found.Error;
    }

    private void StartEdit(MessageInfo message)
    {
        _editing = message.Id;
        _editText = message.Content;
    }

    private async Task SaveEditAsync(MessageInfo message)
    {
        _error = await State.EditAsync(message.Id, _editText);
        if (_error is null)
        {
            _editing = null;
        }
    }

    private async Task DeleteAsync(MessageInfo message) => _error = await State.DeleteAsync(message);

    public void Dispose()
    {
        State.Changed -= OnChanged;
        Calls.Changed -= OnChanged;
        Glossaries.Changed -= OnChanged;
    }
}
