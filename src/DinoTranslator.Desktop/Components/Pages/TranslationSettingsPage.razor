@page "/configuracoes/traducao"
@implements IDisposable
@using System.IO
@using System.Net.Http
@using DinoTranslator.Desktop.Services.Translation
@using DinoTranslator.Desktop.Services.Translation.Local
@using DinoTranslator.Installation
@inject TranslationSettingsStore Store
@inject SpeechEngineFactory Engines
@inject NavigationManager Navigation

<main class="handshake">
  <section class="handshake__panel">
    <div class="handshake__top">
      <span class="setting-row__icon"><Icon Name="traducao" /></span>
      <p class="handshake__kicker">Configurações</p>
    </div>
    <h1 class="handshake__step">Tradução</h1>
    <p class="handshake__hint">
      Basta um dos dois configurar: as legendas chegam à outra pessoa pela própria chamada.
    </p>

    @if (Store.Current.IsConfigured && !_editing)
    {
      <div class="profile-card profile-card--stack">
        <div class="profile-card__text">
          <p class="profile-card__name">@Describe(Store.Current)</p>
          <p class="profile-card__meta"><span class="chip chip--dot @(Engines.IsReady(Store.Current) ? "chip--ok" : "chip--warn")">@StatusOf(Store.Current)</span></p>
        </div>
        <div class="form__actions">
          <button type="button" class="button" @onclick="StartEditing"><Icon Name="editar" />Trocar</button>
          <button type="button" class="button button--quiet" @onclick="Remove"><Icon Name="fechar" />Desligar tradução</button>
        </div>
      </div>
    }
    else
    {
      <div class="login__form">
        <label class="field">
          <span class="field__label">Onde traduzir</span>
          <select class="field__input" @bind="_provider" disabled="@Downloading">
            <option value="@TranslationProvider.Local">Neste computador (sem conta)</option>
            <option value="@TranslationProvider.AzureSpeech">Azure Speech (conta da Microsoft)</option>
            @if (DeveloperMode)
            {
              <option value="@TranslationProvider.Simulated">Simulado (só desenvolvimento)</option>
            }
          </select>
        </label>

        @if (_provider == TranslationProvider.Local)
        {
          <p class="handshake__hint">
            O áudio não sai do computador. O reconhecimento usa a placa de vídeo e a tradução, o processador.
            É preciso baixar os modelos uma vez; eles são conferidos pela assinatura antes de serem usados.
          </p>
          <label class="field">
            <span class="field__label">Modelo de reconhecimento</span>
            <select class="field__input" @bind="_localModel" disabled="@Downloading">
              <option value="@WhisperModel.Turbo">Preciso · Whisper turbo (@Size(LocalModels.WhisperTurbo.Size))</option>
              <option value="@WhisperModel.Small">Rápido · Whisper small (@Size(LocalModels.WhisperSmall.Size))</option>
              <option value="@WhisperModel.Large">Máximo · Whisper large-v3 (@Size(LocalModels.WhisperLarge.Size))</option>
            </select>
          </label>

          <div class="field">
            <span class="field__label">Pasta dos modelos</span>
            <p class="folder-path"><Icon Name="pasta" />@Folder.Path</p>
            <div class="form__actions">
              <button type="button" class="button button--quiet" @onclick="ChooseFolder" disabled="@Downloading"><Icon Name="pasta" />Escolher pasta…</button>
              @if (_modelsFolder is not null)
              {
                <button type="button" class="button button--quiet" @onclick="() => _modelsFolder = null" disabled="@Downloading">Usar a pasta padrão</button>
              }
            </div>
          </div>

          @if (ModelsReady)
          {
            <p class="handshake__waiting">Modelos baixados e conferidos.</p>
          }
          else if (Downloading)
          {
            <div class="download">
              <div class="download__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@_percent">
                <div class="download__fill download__fill--@(_percent / 5 * 5)"></div>
              </div>
              <p class="handshake__waiting">@_percent% · @_downloadingFile</p>
              <button type="button" class="button button--quiet" @onclick="CancelDownload">Cancelar</button>
            </div>
          }
          else
          {
            <button type="button" class="button button--primary" @onclick="DownloadAsync"><Icon Name="baixar" />
              Baixar modelos (@Size(LocalModels.DownloadSize(_localModel)))
            </button>
          }
        }
        else if (_provider == TranslationProvider.AzureSpeech)
        {
          <p class="handshake__hint">
            O áudio das duas pessoas vai deste computador para o Azure Speech durante a chamada.
            A chave fica cifrada aqui e nunca é enviada à outra pessoa.
          </p>
          <label class="field">
            <span class="field__label">Região do recurso</span>
            <input class="field__input" @bind="_region" placeholder="brazilsouth" spellcheck="false" maxlength="32" />
          </label>
          <label class="field">
            <span class="field__label">Chave</span>
            <input class="field__input" type="password" @bind="_key" autocomplete="off" spellcheck="false" maxlength="128" />
          </label>
        }

        @if (_error is not null)
        {
          <p class="login__error" role="alert"><Icon Name="alerta" />@_error</p>
        }

        <div class="form__actions">
          <button type="button" class="button button--primary" @onclick="Save" disabled="@(!CanSave)">Salvar</button>
          @if (Store.Current.IsConfigured)
          {
            <button type="button" class="button" @onclick="() => _editing = false" disabled="@Downloading">Cancelar</button>
          }
        </div>

        @if (_provider == TranslationProvider.Local && Folder.IsInstalled(_localModel) && !Downloading)
        {
          <button type="button" class="button button--quiet handshake__cancel" @onclick="RemoveModels"><Icon Name="lixeira" />
            Apagar os modelos baixados
          </button>
        }
      </div>
    }

    <div class="extras">
      <p class="group-title">Motores extras</p>
      <div class="group extras__card">
        <p class="extras__text">
          faster-whisper, Whisper large-v3, NLLB 1.3B, MarianMT (OPUS-MT) e o detector Silero, para escolher e comparar
          durante a chamada, no botão <strong>Motores</strong>. A placa de vídeo da NVIDIA acelera vários deles.
        </p>
        @if (_extrasProgress is { } progress)
        {
          <div class="download">
            <div class="download__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ExtrasPercent">
              <div class="download__fill download__fill--@(ExtrasPercent / 5 * 5)"></div>
            </div>
            <p class="handshake__waiting">@Gigabytes(progress.DoneBytes) de @Gigabytes(progress.TotalBytes) · @progress.Title</p>
            <button type="button" class="button button--quiet" @onclick="() => _extrasCancel?.Cancel()">Cancelar</button>
          </div>
        }
        else if (MissingExtras is { Count: > 0 } missing)
        {
          <p class="extras__status"><span class="chip chip--dot chip--warn">Faltam @missing.Count de @ExtrasCatalog.All.Count componentes</span></p>
          <button type="button" class="button button--primary" @onclick="InstallExtrasAsync" disabled="@Downloading">
            <Icon Name="baixar" />Instalar motores extras (@Gigabytes(missing.Sum(c => c.Size)))
          </button>
        }
        else
        {
          <p class="extras__status"><span class="chip chip--dot chip--ok">Instalados e conferidos</span></p>
        }
        @if (_extrasError is not null)
        {
          <p class="login__error" role="alert"><Icon Name="alerta" />@_extrasError</p>
        }
      </div>
    </div>

    <button type="button" class="button button--quiet handshake__cancel" @onclick="@(() => Navigation.NavigateTo("/"))" disabled="@(Downloading || _extrasProgress is not null)"><Icon Name="voltar" />Voltar</button>
  </section>
</main>

@code {
    private ExtrasProgress? _extrasProgress;
    private CancellationTokenSource? _extrasCancel;
    private string? _extrasError;

    /// <summary>Os modelos do ajuste já estão em alguma das pastas (a configurada ou a dos extras).</summary>
    private bool ModelsReady =>
        LocalModels.Required(_localModel).All(file => Engines.FolderFor(Draft, file).IsInstalled(file));

    private TranslationSettings Draft => new(TranslationProvider.Local, null, null, _localModel, _modelsFolder);

    /// <summary>Componentes que faltam; modelos originais já baixados na pasta configurada não contam.</summary>
    private IReadOnlyList<ExtraComponent> MissingExtras =>
        ExtrasInstaller.Missing(Engines.Extras.Root)
            .Where(c => c.Kind != ExtraKind.File || !Engines.ModelsFor(Store.Current).IsInstalled(new ModelFile(c.FileName!, c.Source, c.Size, c.Sha256)))
            .ToList();

    private int ExtrasPercent => _extrasProgress is { TotalBytes: > 0 } p ? (int)(p.DoneBytes * 100 / p.TotalBytes) : 0;

    private static string Gigabytes(long bytes) => $"{bytes / 1_000_000_000.0:0.0} GB";

    private async Task InstallExtrasAsync()
    {
        var missing = MissingExtras;
        _extrasError = null;
        _extrasCancel = new CancellationTokenSource();
        _extrasProgress = new ExtrasProgress("começando", 0, missing.Sum(c => c.Size));
        var progress = new Progress<ExtrasProgress>(p =>
        {
            _extrasProgress = p;
            StateHasChanged();
        });
        try
        {
            // O motor auxiliar usa esses arquivos: para antes de substituí-los.
            await Engines.StopExtrasAsync();
            using var http = new HttpClient { Timeout = Timeout.InfiniteTimeSpan };
            http.DefaultRequestHeaders.UserAgent.ParseAdd("DinoTranslator");
            await Task.Run(() => ExtrasInstaller.InstallAsync(Engines.Extras.Root, missing, http, progress, _extrasCancel.Token));
        }
        catch (OperationCanceledException)
        {
            _extrasError = "Instalação dos motores extras cancelada. O que já foi baixado e conferido fica.";
        }
        catch (Exception ex) when (ex is InstallationException or HttpRequestException or IOException or UnauthorizedAccessException)
        {
            _extrasError = ex is InstallationException ? ex.Message : "Não foi possível baixar os motores extras. Confira a internet e tente de novo.";
        }
        finally
        {
            _extrasProgress = null;
            _extrasCancel.Dispose();
            _extrasCancel = null;
        }
    }

    private TranslationProvider _provider = TranslationProvider.Local;
    private WhisperModel _localModel = WhisperModel.Turbo;
    private string? _region;
    private string? _key;
    private string? _error;
    private bool _editing;
    private CancellationTokenSource? _download;
    private int _percent;
    private string _downloadingFile = string.Empty;
    private string? _modelsFolder;

    /// <summary>Folga além do download: o disco não pode ficar cheio.</summary>
    private const long SpareSpace = 1_000_000_000;

    private ModelFolder Folder => _modelsFolder is { } path ? new ModelFolder(path) : Engines.DefaultModels;

    /// <summary>O motor simulado só aparece no build Debug.</summary>
    private static bool DeveloperMode { get; } =
#if DEBUG
        true;
#else
        false;
#endif

    private bool Downloading => _download is not null;

    private bool CanSave => !Downloading && (_provider != TranslationProvider.Local || Folder.IsInstalled(_localModel));

    private void StartEditing()
    {
        _provider = Store.Current.Provider;
        _localModel = Store.Current.LocalModel ?? WhisperModel.Turbo;
        _region = Store.Current.Region;
        _modelsFolder = Store.Current.ModelsFolder;
        _editing = true;
    }

    private void ChooseFolder()
    {
        var dialog = new Microsoft.Win32.OpenFolderDialog { Title = "Pasta dos modelos de tradução" };
        if (dialog.ShowDialog(System.Windows.Application.Current.MainWindow) != true)
        {
            return;
        }
        _error = ModelFolder.ValidatePath(dialog.FolderName);
        if (_error is null)
        {
            _modelsFolder = dialog.FolderName;
        }
    }

    private async Task DownloadAsync()
    {
        _error = null;
        var needed = LocalModels.Required(_localModel).Where(f => !Folder.IsInstalled(f)).Sum(f => f.Size);
        if (Folder.FreeSpace() is { } free && free < needed + SpareSpace)
        {
            _error = $"Falta espaço no disco da pasta dos modelos: precisa de {Size(needed + SpareSpace)} livres e há {Size(free)}. Escolha uma pasta em outro disco.";
            return;
        }
        _percent = 0;
        _download = new CancellationTokenSource();
        var progress = new Progress<DownloadProgress>(p =>
        {
            var percent = (int)(p.Downloaded * 100 / Math.Max(1, p.Total));
            if (percent != _percent || p.FileName != _downloadingFile)
            {
                _percent = percent;
                _downloadingFile = p.FileName;
                StateHasChanged();
            }
        });
        try
        {
            using var http = new HttpClient { Timeout = Timeout.InfiniteTimeSpan };
            await new ModelDownloader(http, Folder).DownloadAsync(LocalModels.Required(_localModel), progress, _download.Token);
        }
        catch (ModelDownloadException ex)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException)
        {
            _error = "Download cancelado. O que já foi baixado e conferido fica guardado.";
        }
        finally
        {
            _download.Dispose();
            _download = null;
        }
    }

    private void CancelDownload() => _download?.Cancel();

    private void Save()
    {
        var settings = _provider switch
        {
            TranslationProvider.AzureSpeech => new TranslationSettings(_provider, _region?.Trim().ToLowerInvariant(), _key?.Trim()),
            TranslationProvider.Local => new TranslationSettings(_provider, null, null, _localModel, _modelsFolder),
            _ => new TranslationSettings(_provider, null, null),
        };
        _error = TranslationSettings.Validate(settings);
        if (_error is not null)
        {
            return;
        }
        Store.Save(settings);
        _key = null;
        _editing = false;
    }

    private void Remove()
    {
        Store.Clear();
        _region = null;
        _key = null;
    }

    private void RemoveModels()
    {
        Engines.ReleaseLocal();
        Folder.Remove();
        if (Store.Current.Provider == TranslationProvider.Local)
        {
            Store.Clear();
        }
    }

    private string StatusOf(TranslationSettings settings) => settings.Provider switch
    {
        TranslationProvider.AzureSpeech => "Chave guardada neste computador.",
        TranslationProvider.Local when Engines.IsReady(settings) => "Modelos baixados. O áudio não sai do computador.",
        TranslationProvider.Local => "Os modelos não estão mais no computador. Baixe de novo em Trocar.",
        _ => string.Empty,
    };

    public static string Describe(TranslationSettings settings) => settings.Provider switch
    {
        TranslationProvider.AzureSpeech => $"Azure Speech · {settings.Region}",
        TranslationProvider.Local => $"Neste computador · {settings.LocalModel switch { WhisperModel.Small => "rápido", WhisperModel.Large => "máximo", _ => "preciso" }}",
        TranslationProvider.Simulated => "Simulado (desenvolvimento)",
        _ => "Não configurado",
    };

    private static string Size(long bytes) =>
        bytes >= 1_000_000_000
            ? $"{bytes / 1_000_000_000.0:0.00} GB".Replace('.', ',')
            : $"{bytes / 1_000_000} MB";

    public void Dispose() => _download?.Cancel();
}
