@page "/chamada"
@implements IDisposable
@inject CallSession Call
@inject ProfileStore Profiles
@inject NavigationManager Navigation

<main class="call">
  <header class="call__bar">
    <p class="call__peer">
      @Call.Peer?.Name
      @if (Call.Peer is { } peer)
      {
        <span class="tag tag--other">@Languages.Get(peer.Language).Tag</span>
      }
    </p>
    @if (Call.SecurityCode is { } securityCode)
    {
      <p class="call__security" title="Os dois devem ver o mesmo número. Se for diferente, encerrem a chamada.">
        código de segurança <span class="call__digits">@securityCode</span>
      </p>
    }
    <p class="call__route">
      @if (Call.RoundTripMs is { } rtt)
      {
        <span>@rtt ms</span>
      }
      @if (Call.Route is { } route)
      {
        <span> · conexão @route</span>
      }
    </p>
  </header>

  @if (Call.Problem is { } problem)
  {
    <p class="call__problem" role="alert">
      @problem
      @if (Call.Stage is CallStage.Ended or CallStage.Idle)
      {
        <button type="button" class="button button--quiet" @onclick="BackHome">Voltar ao início</button>
      }
    </p>
  }

  @if (Call.SharingScreen)
  {
    <div class="call__sharing" role="status">
      <span class="call__sharing-label">Você está compartilhando a tela</span>
      @if (Call.ScreenStats is { } sent)
      {
        <span class="call__sharing-stats">enviando @sent</span>
      }
      <div class="segmented" role="group" aria-label="Qualidade da tela">
        <button type="button" class="segmented__option @(Call.ScreenMode == ScreenMode.Detail ? "segmented__option--on" : "")"
                aria-pressed="@(Call.ScreenMode == ScreenMode.Detail ? "true" : "false")" @onclick="() => Call.SetScreenModeAsync(ScreenMode.Detail)">
          Nítida · texto
        </button>
        <button type="button" class="segmented__option @(Call.ScreenMode == ScreenMode.Motion ? "segmented__option--on" : "")"
                aria-pressed="@(Call.ScreenMode == ScreenMode.Motion ? "true" : "false")" @onclick="() => Call.SetScreenModeAsync(ScreenMode.Motion)">
          Fluida · vídeo
        </button>
      </div>
      <button type="button" class="button button--quiet" @onclick="Call.StopScreenShareAsync">Parar</button>
    </div>
  }

  <section class="call__stage @(Call.RemoteScreen ? "call__stage--screen" : "")">
    <figure class="screen-tile">
      <video @ref="_remoteScreen" autoplay playsinline muted></video>
      <figcaption>
        Tela de @Call.Peer?.Name
        @if (!Call.SharingScreen && Call.ScreenStats is { } received)
        {
          <span> · @received</span>
        }
      </figcaption>
    </figure>
    <figure class="video-tile tile--other">
      <video @ref="_remoteVideo" autoplay playsinline></video>
      <figcaption>@Call.Peer?.Name</figcaption>
    </figure>
    <figure class="video-tile tile--me">
      <video @ref="_localVideo" autoplay playsinline muted></video>
      <figcaption>Você@(Profiles.Current is { } me ? $" · {Languages.Get(me.Language).Tag}" : "")</figcaption>
    </figure>
  </section>

  <footer class="call__dock">
    <button type="button" class="dock-button @(_microphone ? "dock-button--on" : "")" @onclick="ToggleMicrophoneAsync"
            disabled="@(!Live)" aria-pressed="@(_microphone ? "true" : "false")">
      @(_microphone ? "Microfone" : "Microfone mudo")
    </button>
    <button type="button" class="dock-button @(_camera ? "dock-button--on" : "")" @onclick="ToggleCameraAsync"
            disabled="@(!Live)" aria-pressed="@(_camera ? "true" : "false")">
      @(_camera ? "Câmera" : "Câmera desligada")
    </button>
    <button type="button" class="dock-button @(Call.SharingScreen ? "dock-button--on" : "")" @onclick="ToggleScreenAsync"
            disabled="@(!Live)" aria-pressed="@(Call.SharingScreen ? "true" : "false")">
      @(Call.SharingScreen ? "Parar tela" : "Compartilhar tela")
    </button>
    <button type="button" class="dock-button dock-button--end" @onclick="HangUpAsync">Encerrar</button>
  </footer>
</main>

@code {
    private ElementReference _localVideo;
    private ElementReference _remoteVideo;
    private ElementReference _remoteScreen;
    private bool _microphone = true;
    private bool _camera = true;
    private bool _mediaStarted;

    private bool Live => Call.Stage == CallStage.Connected;

    protected override void OnInitialized()
    {
        if (Call.Stage is CallStage.Idle)
        {
            Navigation.NavigateTo("/");
            return;
        }
        Call.Changed += OnCallChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _mediaStarted || !Live)
        {
            return;
        }
        _mediaStarted = true;
        await Call.BindRemoteScreenAsync(_remoteScreen);
        try
        {
            await Call.StartMediaAsync(_localVideo, _remoteVideo, highFidelity: false);
        }
        catch (JSException)
        {
            _microphone = false;
            _camera = false;
            Call.OnMediaError("getUserMedia");
        }
    }

    private async Task ToggleMicrophoneAsync()
    {
        _microphone = !_microphone;
        await Call.SetMicrophoneAsync(_microphone);
    }

    private async Task ToggleCameraAsync()
    {
        _camera = !_camera;
        await Call.SetCameraAsync(_camera);
    }

    private Task ToggleScreenAsync() =>
        Call.SharingScreen ? Call.StopScreenShareAsync() : Call.StartScreenShareAsync();

    private async Task HangUpAsync()
    {
        await Call.HangUpAsync();
        Navigation.NavigateTo("/");
    }

    private void BackHome() => Navigation.NavigateTo("/");

    private void OnCallChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Call.Changed -= OnCallChanged;
}
