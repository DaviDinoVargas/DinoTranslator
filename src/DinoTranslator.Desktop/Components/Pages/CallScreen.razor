@page "/chamada"
@implements IDisposable
@using DinoTranslator.Shared.Call
@inject CallSession Call
@inject ProfileStore Profiles
@inject NavigationManager Navigation

<main class="call @(_conversation ? "call--chat" : "")">

    <section class="call__stage @(Call.RemoteScreen ? "call__stage--screen" : "")" aria-label="Vídeo da chamada">
      <figure class="screen-tile">
        <video @ref="_remoteScreen" autoplay playsinline muted></video>
        <figcaption>
          Tela de @Call.Peer?.Name
          @if (!Call.SharingScreen && Call.ScreenStats is { } received)
          {
            <span> · @received</span>
          }
        </figcaption>
      </figure>
      <figure class="video-tile tile--other">
        <video @ref="_remoteVideo" autoplay playsinline></video>
        <figcaption>@Call.Peer?.Name@(_sound ? "" : " · som desligado")</figcaption>
      </figure>
      <figure class="video-tile tile--me @(_camera ? "" : "video-tile--off")">
        <video @ref="_localVideo" autoplay playsinline muted></video>
        <figcaption>Você@(Profiles.Current is { } me ? $" · {Languages.Get(me.Language).Tag}" : "")@(_microphone ? "" : " · mudo")</figcaption>
      </figure>
      @if (Call.Floating)
      {
        <p class="call__floating-note"><Icon Name="flutuante" />A imagem de @Call.Peer?.Name está na janela flutuante.</p>
      }
      <CaptionStrip />
    <header class="call__bar">
      <div class="call__who">
        <Avatar Name="@Call.Peer?.Name" />
        <div>
          <p class="call__peer">
            @Call.Peer?.Name
            @if (Call.Peer is { } peer)
            {
              <span class="tag tag--other">@Languages.Get(peer.Language).Tag</span>
            }
          </p>
          @if (Call.Peer is { } speaker)
          {
            <p class="call__subline">fala @Languages.Get(speaker.Language).NativeName</p>
          }
        </div>
      </div>
      @if (Call.SecurityCode is { } securityCode)
      {
        <p class="call__security" title="Os dois devem ver o mesmo número. Se for diferente, encerrem a chamada.">
          <Icon Name="escudo" /><span class="call__security-label">código de segurança</span> <span class="call__digits">@securityCode</span>
        </p>
      }
      @if (Call.RoundTripMs is { } rtt)
      {
        <p class="call__route" title="Tempo de ida e volta até o outro computador">
          <span class="signal signal--@SignalLevel(rtt)" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span>@rtt ms</span>
          @if (Call.Route is { } route)
          {
            <span class="call__route-path"> · conexão @route</span>
          }
        </p>
      }
      else
      {
        <p class="call__route"></p>
      }
      <label class="call__quality">
        <span>Vídeo</span>
        <select value="@Call.VideoQuality" @onchange="ChangeQualityAsync" disabled="@(!Live)" aria-label="Qualidade do vídeo enviado">
          <option value="@VideoQuality.Maxima">Máxima · 1080p</option>
          <option value="@VideoQuality.Alta">Alta · 720p</option>
          <option value="@VideoQuality.Media">Média · 480p</option>
          <option value="@VideoQuality.Baixa">Baixa · 360p</option>
        </select>
      </label>
    </header>
    @if (Call.Problem is { } problem)
    {
      <p class="call__problem" role="alert">
        <Icon Name="alerta" />@problem
        @if (Call.Stage is CallStage.Ended or CallStage.Idle)
        {
          <button type="button" class="button button--quiet" @onclick="BackHome">Voltar ao início</button>
        }
      </p>
    }

    @if (Call.SharingScreen)
    {
      <div class="call__sharing" role="status">
        <Icon Name="tela" /><span class="call__sharing-label">Você está compartilhando a tela</span>
        @if (Call.ScreenStats is { } sent)
        {
          <span class="call__sharing-stats">enviando @sent</span>
        }
        <div class="segmented" role="group" aria-label="Qualidade da tela">
          <button type="button" class="segmented__option @(Call.ScreenMode == ScreenMode.Detail ? "segmented__option--on" : "")"
                  aria-pressed="@(Call.ScreenMode == ScreenMode.Detail ? "true" : "false")" @onclick="() => Call.SetScreenModeAsync(ScreenMode.Detail)">
            Nítida · texto
          </button>
          <button type="button" class="segmented__option @(Call.ScreenMode == ScreenMode.Motion ? "segmented__option--on" : "")"
                  aria-pressed="@(Call.ScreenMode == ScreenMode.Motion ? "true" : "false")" @onclick="() => Call.SetScreenModeAsync(ScreenMode.Motion)">
            Fluida · vídeo
          </button>
        </div>
        <button type="button" class="button button--quiet" @onclick="Call.StopScreenShareAsync">Parar</button>
      </div>
    }

    <footer class="call__dock">
      <button type="button" class="dock-button @(_microphone ? "dock-button--on" : "dock-button--muted")" @onclick="ToggleMicrophoneAsync"
              disabled="@(!Live || !_hasMicrophone)" aria-pressed="@(_microphone ? "true" : "false")" title="Seu microfone">
        <Icon Name="@(_microphone ? "microfone" : "microfone-mudo")" /><span>@(_microphone ? "Microfone" : "Microfone mudo")</span>
      </button>
      <button type="button" class="dock-button @(_camera ? "dock-button--on" : "dock-button--muted")" @onclick="ToggleCameraAsync"
              disabled="@(!Live || !_hasCamera)" aria-pressed="@(_camera ? "true" : "false")" title="Sua câmera">
        <Icon Name="@(_camera ? "camera" : "camera-desligada")" /><span>@(_camera ? "Câmera" : "Câmera desligada")</span>
      </button>
      <button type="button" class="dock-button @(_sound ? "dock-button--on" : "dock-button--muted")" @onclick="ToggleSoundAsync"
              disabled="@(!Live)" aria-pressed="@(_sound ? "true" : "false")" title="Som da outra pessoa neste computador">
        <Icon Name="@(_sound ? "som" : "som-mudo")" /><span>@(_sound ? "Som da chamada" : "Som desligado")</span>
      </button>
      <span class="dock__divider" aria-hidden="true"></span>
      <button type="button" class="dock-button @(Call.SharingScreen ? "dock-button--active" : "")" @onclick="ToggleScreenAsync"
              disabled="@(!Live)" aria-pressed="@(Call.SharingScreen ? "true" : "false")" title="Mostrar uma tela ou janela">
        <Icon Name="tela" /><span>@(Call.SharingScreen ? "Parar tela" : "Compartilhar tela")</span>
      </button>
      <button type="button" class="dock-button @(_conversation ? "dock-button--active" : "")" @onclick="() => _conversation = !_conversation"
              aria-pressed="@(_conversation ? "true" : "false")" title="Painel com a conversa traduzida">
        <Icon Name="conversa" /><span>Conversa</span>
      </button>
      <button type="button" class="dock-button @(Call.Floating ? "dock-button--active" : "")" @onclick="ToggleFloatingAsync"
              disabled="@(!Live)" aria-pressed="@(Call.Floating ? "true" : "false")" title="Janela sempre por cima, que pode ir para outro monitor">
        <Icon Name="flutuante" /><span>Janela flutuante</span>
      </button>
      <button type="button" class="dock-button dock-button--end" @onclick="HangUpAsync" title="Encerrar a chamada">
        <Icon Name="desligar" /><span>Encerrar</span>
      </button>
    </footer>
    </section>

  @if (_conversation)
  {
    <ConversationPanel OnClose="() => _conversation = false" />
  }

</main>

@code {
    private ElementReference _localVideo;
    private ElementReference _remoteVideo;
    private ElementReference _remoteScreen;
    private bool _microphone = true;
    private bool _camera = true;
    private bool _sound = true;
    private bool _hasMicrophone = true;
    private bool _hasCamera = true;
    private bool _conversation = true;
    private bool _mediaStarted;
    private string? _floatingText;

    private bool Live => Call.Stage == CallStage.Connected;

    /// <summary>Barras de sinal pela latência: 4 até 100 ms, 1 acima de 400 ms.</summary>
    private static int SignalLevel(int roundTripMs) => roundTripMs switch
    {
        < 100 => 4,
        < 200 => 3,
        < 400 => 2,
        _ => 1,
    };

    protected override void OnInitialized()
    {
        if (Call.Stage is CallStage.Idle)
        {
            Navigation.NavigateTo("/");
            return;
        }
        Call.Changed += OnCallChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _mediaStarted || !Live)
        {
            return;
        }
        _mediaStarted = true;
        await Call.BindRemoteScreenAsync(_remoteScreen);
        try
        {
            var media = await Call.StartMediaAsync(_localVideo, _remoteVideo, highFidelity: false);
            _hasCamera = _camera = media.Camera;
            _hasMicrophone = _microphone = media.Microphone;
        }
        catch (JSException)
        {
            _hasMicrophone = _microphone = false;
            _hasCamera = _camera = false;
            Call.OnMediaError("getUserMedia");
        }
        StateHasChanged();
    }

    private async Task ToggleMicrophoneAsync()
    {
        _microphone = !_microphone;
        await Call.SetMicrophoneAsync(_microphone);
    }

    private async Task ToggleCameraAsync()
    {
        _camera = !_camera;
        await Call.SetCameraAsync(_camera);
    }

    private async Task ToggleSoundAsync()
    {
        _sound = !_sound;
        await Call.SetRemoteAudioAsync(_sound);
    }

    private Task ChangeQualityAsync(ChangeEventArgs e) =>
        Call.SetVideoQualityAsync(Enum.TryParse<VideoQuality>(e.Value?.ToString(), out var quality) ? quality : VideoQuality.Maxima);

    private Task ToggleScreenAsync() =>
        Call.SharingScreen ? Call.StopScreenShareAsync() : Call.StartScreenShareAsync();

    private async Task ToggleFloatingAsync()
    {
        if (Call.Floating)
        {
            await Call.CloseFloatingAsync();
            return;
        }
        try
        {
            if (await Call.OpenFloatingAsync())
            {
                _floatingText = null;
                await PushFloatingCaptionAsync();
            }
        }
        catch (JSException)
        {
            Call.OnMediaError("janela flutuante");
        }
    }

    /// <summary>A legenda da outra pessoa acompanha a janela flutuante.</summary>
    private async Task PushFloatingCaptionAsync()
    {
        if (!Call.Floating)
        {
            return;
        }
        var caption = Call.Captions.Visible().LastOrDefault(c => c.Owner == CaptionOwner.Other);
        var main = caption is null ? null : caption.TranslatedText ?? caption.SourceText;
        var secondary = caption?.TranslatedText is null ? null : caption.SourceText;
        var key = $"{main}\u0001{secondary}\u0001{Call.RemoteScreen}";
        if (key != _floatingText)
        {
            _floatingText = key;
            await Call.UpdateFloatingAsync(main, secondary);
        }
    }

    private async Task HangUpAsync()
    {
        await Call.HangUpAsync();
        Navigation.NavigateTo("/");
    }

    private void BackHome() => Navigation.NavigateTo("/");

    private void OnCallChanged() => InvokeAsync(async () =>
    {
        StateHasChanged();
        try
        {
            await PushFloatingCaptionAsync();
        }
        catch (JSException)
        {
            // Janela flutuante fechando junto: a próxima legenda tenta de novo.
        }
    });

    public void Dispose() => Call.Changed -= OnCallChanged;
}
