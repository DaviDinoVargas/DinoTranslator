@page "/"
@inject DesktopSettings Settings
@inject ProfileStore Profiles
@inject DinoTranslator.Desktop.Services.Translation.TranslationSettingsStore Translation
@inject ConnectionSettingsStore Connection
@inject NavigationManager Navigation

@if (Settings.Mode == ConnectionMode.Code)
{
  <main class="home">
    <div class="page__column">
      <header class="hero">
        <BrandMark Class="brand-mark--grande" />
        <h1 class="hero__title">DinoTranslator</h1>
        <p class="hero__subtitle">Videochamada com tradução simultânea, direto entre os dois computadores.</p>
        <div class="hero__languages" aria-label="Idiomas">
          @foreach (var language in Languages.All)
          {
            <span class="chip">@language.NativeName</span>
          }
        </div>
      </header>

      @if (Profiles.Current is not { } profile || _editing)
      {
        <section class="group home__panel">
          <div>
            <h2 class="handshake__step">@(Profiles.Current is null ? "Antes da primeira chamada" : "Editar perfil")</h2>
            <p class="home__lead">
              @(Profiles.Current is null ? "O nome e o idioma vão no convite; o gênero e o tratamento ajudam a tradução a concordar." : "As mudanças valem a partir da próxima chamada.")
            </p>
          </div>
          <ProfileForm OnSaved="() => _editing = false"
                       OnCancel="@(Profiles.Current is null ? default(EventCallback) : EventCallback.Factory.Create(this, () => _editing = false))" />
        </section>
      }
      else
      {
        <button type="button" class="profile-card" @onclick="() => _editing = true" title="Editar perfil">
          <Avatar Name="@profile.Name" Mine="true" Class="avatar--large" />
          <span class="profile-card__text">
            <span class="profile-card__name">@profile.Name</span>
            <span class="profile-card__meta">
              @Languages.Get(profile.Language).NativeName · tratamento @(profile.Formality == Formality.Formal ? "formal" : "informal")
            </span>
          </span>
          <Icon Name="seta" />
        </button>

        @if (!Translation.Current.IsConfigured)
        {
          <div class="callout" role="note">
            <Icon Name="alerta" />
            <p>A tradução ainda não está ligada neste computador. Sem ela em pelo menos um dos dois, a chamada fica sem legendas.</p>
            <button type="button" class="button button--primary button--small" @onclick="@(() => Navigation.NavigateTo("/configuracoes/traducao"))">Configurar a tradução</button>
          </div>
        }

        <div class="home__actions">
          <button type="button" class="button button--primary" @onclick="@(() => Navigation.NavigateTo("/chamada/convite"))">
            <Icon Name="nova-chamada" />Nova chamada
          </button>
          <button type="button" class="button" @onclick="@(() => Navigation.NavigateTo("/chamada/entrar"))">
            <Icon Name="entrar" />Entrar com código
          </button>
        </div>

        <button type="button" class="plus-card" @onclick="@(() => Navigation.NavigateTo("/conta"))">
          <span class="plus-card__badge">Plus</span>
          <span class="plus-card__text">
            <span class="plus-card__title">Grupos, chat e chamadas em grupo</span>
            <span class="plus-card__meta">Com conta no seu servidor: canais, amigos, conversas traduzidas e chamadas com várias pessoas.</span>
          </span>
          <Icon Name="seta" />
        </button>

        <p class="group-title">Ajustes</p>
        <nav class="group" aria-label="Ajustes">
          <button type="button" class="setting-row" @onclick="@(() => Navigation.NavigateTo("/configuracoes/traducao"))">
            <span class="setting-row__icon"><Icon Name="traducao" /></span>
            <span class="setting-row__label">Tradução</span>
            <span class="setting-row__value">
              @(Translation.Current.IsConfigured ? TranslationSettingsPage.Describe(Translation.Current) : "Desligada")
            </span>
            <Icon Name="seta" />
          </button>
          <button type="button" class="setting-row" @onclick="@(() => Navigation.NavigateTo("/configuracoes/dispositivos"))">
            <span class="setting-row__icon setting-row__icon--verde"><Icon Name="fone" /></span>
            <span class="setting-row__label">Câmera e áudio</span>
            <span class="setting-row__value">Testar</span>
            <Icon Name="seta" />
          </button>
          <button type="button" class="setting-row" @onclick="@(() => Navigation.NavigateTo("/configuracoes/conexao"))">
            <span class="setting-row__icon setting-row__icon--indigo"><Icon Name="rede" /></span>
            <span class="setting-row__label">Conexão</span>
            <span class="setting-row__value">@(Connection.Current.HasRelay ? "Com retransmissão" : "Direta")</span>
            <Icon Name="seta" />
          </button>
        </nav>

        <p class="home__footer">
          <Icon Name="cadeado" Class="icon--inline" />Cifrada de ponta a ponta, sem servidor no meio.
        </p>
      }
    </div>
  </main>
}

@code {
    private bool _editing;
}
