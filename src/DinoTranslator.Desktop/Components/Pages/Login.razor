@page "/login"
@inject AuthClient Auth
@inject NavigationManager Navigation

<main class="login">
  <section class="login__panel" aria-labelledby="login-title">
    <p class="login__mark" aria-hidden="true">DT</p>
    <h1 id="login-title" class="login__title">DinoTranslator</h1>
    <p class="login__languages">Português <span aria-hidden="true">⇄</span> Русский</p>

    @if (_checkingSession)
    {
      <p class="login__status">Retomando a sessão…</p>
    }
    else
    {
      <EditForm Model="_form" OnSubmit="SubmitAsync" class="login__form">
        <label class="field">
          <span class="field__label">Usuário</span>
          <InputText @bind-Value="_form.UserName" class="field__input" autocomplete="username" spellcheck="false" maxlength="32" />
        </label>
        <label class="field">
          <span class="field__label">Senha</span>
          <InputText @bind-Value="_form.Password" type="password" class="field__input" autocomplete="current-password" maxlength="128" />
        </label>
        <label class="check">
          <InputCheckbox @bind-Value="_form.Remember" />
          <span>Manter conectado neste computador</span>
        </label>

        @if (_error is not null)
        {
          <p class="login__error" role="alert">@_error</p>
        }

        <button type="submit" class="button button--primary" disabled="@_busy">
          @(_busy ? "Entrando…" : "Entrar")
        </button>
      </EditForm>
    }
  </section>
</main>

@code {
    private readonly LoginForm _form = new();
    private bool _checkingSession = true;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.TryResumeAsync())
        {
            Navigation.NavigateTo("/sala");
            return;
        }
        _checkingSession = false;
    }

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.UserName) || string.IsNullOrEmpty(_form.Password))
        {
            _error = "Informe usuário e senha.";
            return;
        }

        _busy = true;
        _error = null;
        var result = await Auth.LoginAsync(_form.UserName, _form.Password, _form.Remember);
        _form.Password = string.Empty;
        _busy = false;

        _error = result switch
        {
            LoginResult.Success => null,
            LoginResult.InvalidCredentials => "Usuário ou senha inválidos.",
            LoginResult.TooManyAttempts => "Muitas tentativas. Aguarde um minuto e tente de novo.",
            _ => "Não foi possível falar com o servidor.",
        };
        if (result == LoginResult.Success)
        {
            Navigation.NavigateTo("/sala");
        }
    }

    private sealed class LoginForm
    {
        public string UserName { get; set; } = string.Empty;

        public string Password { get; set; } = string.Empty;

        public bool Remember { get; set; }
    }
}
