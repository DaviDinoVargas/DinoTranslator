@page "/chamada/convite"
@implements IDisposable
@using DinoTranslator.Shared.Call
@inject CallSession Call
@inject NavigationManager Navigation

<main class="handshake">
  <section class="handshake__panel">
    <div class="handshake__top">
      <BrandMark />
      <p class="handshake__kicker">Nova chamada</p>
    </div>
    <ol class="stepper" aria-label="Andamento">
      <li class="stepper__item @(Call.Stage is CallStage.WaitingAnswer or CallStage.Idle ? "stepper__item--now" : "stepper__item--done")" data-step="1">Convite</li>
      <li class="stepper__item @(Call.Stage == CallStage.Connecting ? "stepper__item--now" : "")" data-step="2">Resposta</li>
      <li class="stepper__item" data-step="3">Chamada</li>
    </ol>

    @if (Call.Stage == CallStage.Ended)
    {
      <h1 class="handshake__step">A chamada não conectou</h1>
      <p class="login__error" role="alert"><Icon Name="alerta" />@Call.Problem</p>
      <div class="form__actions">
        <button type="button" class="button button--primary" @onclick="NewInviteAsync"><Icon Name="repetir" />Criar novo convite</button>
      </div>
    }
    else if (Call.Stage == CallStage.Connecting)
    {
      <div class="handshake__connecting">
        <div class="radar"><Avatar Name="@Call.Peer?.Name" /></div>
        <h1 class="handshake__step">Conectando com @Call.Peer?.Name<span class="connecting" aria-hidden="true"></span></h1>
        <p class="handshake__hint">Os dois computadores estão se procurando pela internet. Costuma levar poucos segundos.</p>
      </div>
    }
    else
    {
      <h1 class="handshake__step">Envie o convite</h1>
      @if (_invite is null)
      {
        <p class="handshake__hint">@(_error is null ? "Preparando o convite…" : "")</p>
      }
      else
      {
        <p class="handshake__hint">
          Copie e mande pelo mensageiro. Vale até @Call.InviteExpiresAt?.ToLocalTime().ToString("HH:mm") e para uma única pessoa.
        </p>
        <textarea class="code-box" readonly rows="4" aria-label="Código de convite">@_invite</textarea>
        <button type="button" class="button button--primary" @onclick="CopyInvite">
          <Icon Name="@(_copied ? "ok" : "copiar")" />@(_copied ? "Convite copiado" : "Copiar convite")
        </button>

        @if (Call.AutoConnect == AutoConnect.Listening)
        {
          <p class="handshake__waiting">
            Aguardando<span class="connecting" aria-hidden="true"></span> Quando a outra pessoa colar o convite, a chamada conecta sozinha.
          </p>
        }

        <details class="handshake__manual" open="@(Call.AutoConnect != AutoConnect.Listening)">
          <summary>@(Call.AutoConnect == AutoConnect.Listening ? "Não conectou sozinho? Cole a resposta" : "Cole a resposta")</summary>
          <p class="handshake__hint">Se a outra pessoa mandar o código de resposta pelo mensageiro, cole aqui.</p>
          <textarea class="code-box" rows="4" placeholder="DT1.…" spellcheck="false" aria-label="Código de resposta"
                    @bind="_answer" @bind:event="oninput"></textarea>
          <div class="form__actions">
            <button type="button" class="button" @onclick="PasteAnswer"><Icon Name="colar" />Colar</button>
            <button type="button" class="button button--primary" @onclick="ConnectAsync"
                    disabled="@string.IsNullOrWhiteSpace(_answer)">Conectar</button>
          </div>
        </details>
      }
    }

    @if (_error is not null && Call.Stage != CallStage.Ended)
    {
      <p class="login__error" role="alert"><Icon Name="alerta" />@_error</p>
    }

    <button type="button" class="button button--quiet handshake__cancel" @onclick="CancelAsync"><Icon Name="voltar" />
      @(Call.Stage == CallStage.Ended ? "Voltar ao início" : "Cancelar")
    </button>
  </section>
</main>

@code {
    private string? _invite;
    private string _answer = string.Empty;
    private string? _error;
    private bool _copied;

    protected override async Task OnInitializedAsync()
    {
        Call.Changed += OnCallChanged;
        await CreateInviteAsync();
    }

    private async Task CreateInviteAsync()
    {
        _invite = null;
        _answer = string.Empty;
        _error = null;
        _copied = false;
        try
        {
            _invite = await Call.CreateInviteAsync();
        }
        catch (CallCodeException ex)
        {
            _error = ex.Message;
        }
        catch (JSException)
        {
            _error = "Não foi possível preparar a conexão neste computador.";
        }
    }

    private Task NewInviteAsync() => CreateInviteAsync();

    private void CopyInvite()
    {
        ClipboardText.Copy(_invite!);
        _copied = true;
    }

    private void PasteAnswer() => _answer = ClipboardText.Paste();

    private async Task ConnectAsync()
    {
        _error = null;
        try
        {
            await Call.AcceptAnswerAsync(_answer);
        }
        catch (CallCodeException ex)
        {
            _error = ex.Message;
        }
        catch (JSException)
        {
            _error = "Não foi possível preparar a conexão neste computador.";
        }
    }

    private async Task CancelAsync()
    {
        await Call.HangUpAsync();
        Navigation.NavigateTo("/");
    }

    private void OnCallChanged() => InvokeAsync(() =>
    {
        if (Call.Stage == CallStage.Connected)
        {
            Navigation.NavigateTo("/chamada");
            return;
        }
        StateHasChanged();
    });

    public void Dispose() => Call.Changed -= OnCallChanged;
}
