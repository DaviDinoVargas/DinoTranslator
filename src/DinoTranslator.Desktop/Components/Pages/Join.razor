@page "/chamada/entrar"
@implements IDisposable
@using DinoTranslator.Shared.Call
@inject CallSession Call
@inject NavigationManager Navigation

<main class="handshake">
  <section class="handshake__panel">
    <p class="handshake__kicker">Entrar com código</p>

    @if (_answerCode is not null && Call.Stage == CallStage.Ended)
    {
      <h1 class="handshake__step">A chamada não conectou</h1>
      <p class="login__error" role="alert">@Call.Problem</p>
      <div class="form__actions">
        <button type="button" class="button button--primary" @onclick="StartOver">Colar outro convite</button>
      </div>
    }
    else if (_answerCode is null)
    {
      <h1 class="handshake__step">1 · Cole o convite</h1>
      <p class="handshake__hint">Cole o código de convite que você recebeu pelo mensageiro.</p>
      <textarea class="code-box" rows="4" placeholder="DT1.…" spellcheck="false" aria-label="Código de convite"
                @bind="_invite" @bind:event="oninput" disabled="@_busy"></textarea>
      <div class="form__actions">
        <button type="button" class="button" @onclick="PasteInvite" disabled="@_busy">Colar</button>
        <button type="button" class="button button--primary" @onclick="AnswerAsync"
                disabled="@(_busy || string.IsNullOrWhiteSpace(_invite))">
          @(_busy ? "Preparando…" : "Entrar na chamada")
        </button>
      </div>
    }
    else
    {
      <h1 class="handshake__step">Conectando com @Call.Peer?.Name<span class="connecting" aria-hidden="true"></span></h1>
      <p class="handshake__hint">@AutoConnectHint</p>

      <details class="handshake__manual" open="@ManualOpen">
        <summary>@(ManualOpen ? "Mande a resposta pelo mensageiro" : "Não conectou em um minuto? Mande a resposta")</summary>
        <p class="handshake__hint">Copie e mande para <strong>@Call.Peer?.Name</strong>, que cola no convite que criou.</p>
        <textarea class="code-box" readonly rows="4" aria-label="Código de resposta">@_answerCode</textarea>
        <button type="button" class="button button--primary" @onclick="CopyAnswer">
          @(_copied ? "Resposta copiada" : "Copiar resposta")
        </button>
      </details>
    }

    @if (_error is not null)
    {
      <p class="login__error" role="alert">@_error</p>
    }

    <button type="button" class="button button--quiet handshake__cancel" @onclick="CancelAsync">
      @(Call.Stage == CallStage.Ended ? "Voltar ao início" : "Cancelar")
    </button>
  </section>
</main>

@code {
    private string _invite = string.Empty;
    private string? _answerCode;
    private string? _error;
    private bool _busy;
    private bool _copied;

    private bool ManualOpen => Call.AutoConnect is AutoConnect.Off or AutoConnect.Unavailable;

    private string AutoConnectHint => Call.AutoConnect switch
    {
        AutoConnect.Sending => "Enviando a resposta automaticamente…",
        AutoConnect.Sent => $"Resposta enviada. Com o convite aberto no computador de {Call.Peer?.Name}, a chamada conecta sozinha.",
        AutoConnect.Unavailable => "Não deu para enviar a resposta automaticamente. Mande-a pelo mensageiro.",
        _ => "Mande a resposta pelo mensageiro.",
    };

    protected override void OnInitialized() => Call.Changed += OnCallChanged;

    private void PasteInvite() => _invite = ClipboardText.Paste();

    private async Task AnswerAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            _answerCode = await Call.AcceptInviteAsync(_invite);
        }
        catch (CallCodeException ex)
        {
            _error = ex.Message;
        }
        catch (JSException)
        {
            _error = "Não foi possível preparar a conexão neste computador.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartOver()
    {
        _answerCode = null;
        _invite = string.Empty;
        _copied = false;
        _error = null;
    }

    private void CopyAnswer()
    {
        ClipboardText.Copy(_answerCode!);
        _copied = true;
    }

    private async Task CancelAsync()
    {
        await Call.HangUpAsync();
        Navigation.NavigateTo("/");
    }

    private void OnCallChanged() => InvokeAsync(() =>
    {
        if (Call.Stage == CallStage.Connected)
        {
            Navigation.NavigateTo("/chamada");
            return;
        }
        StateHasChanged();
    });

    public void Dispose() => Call.Changed -= OnCallChanged;
}
