<Window x:Class="DinoTranslator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DinoTranslator"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Tinta}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Tinta}" BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border Width="22" Height="22" Background="{StaticResource Ipe}">
            <TextBlock Text="DT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource Tinta}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="DinoTranslator" Margin="10,0,0,0" FontSize="13"
                     Foreground="{StaticResource Papel}" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="Clocks" Grid.Column="1" VerticalAlignment="Center"
                   FontFamily="Consolas" FontSize="12" Foreground="{StaticResource Papel2}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar"
                  WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize" />
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizar"
                  WindowChrome.IsHitTestVisibleInChrome="True" Click="OnToggleMaximize" />
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Fechar"
                  WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="Host" Grid.Row="1" />
  </Grid>
</Window>
