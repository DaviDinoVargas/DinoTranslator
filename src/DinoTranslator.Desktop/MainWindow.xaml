<Window x:Class="DinoTranslator.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DinoTranslator"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Icon="Assets/DinoTranslator.ico" Background="{StaticResource Tinta}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Sem divisória: a barra continua no papel de parede da interface. -->
    <Border Grid.Row="0" Background="{StaticResource Tinta}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Image Source="Assets/DinoTranslator.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="DinoTranslator" Margin="10,0,0,0" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
                     FontWeight="SemiBold" Foreground="{StaticResource Papel}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Relógios numa pílula translúcida, no centro. -->
        <Border Grid.Column="1" VerticalAlignment="Center" Padding="14,4" CornerRadius="12"
                Background="{StaticResource Vidro}" BorderBrush="{StaticResource VidroBorda}" BorderThickness="1">
          <TextBlock x:Name="Clocks" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource Papel2}" />
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="0,0,16,0"
                     FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="{StaticResource Papel2}" />
          <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimizar"
                  WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize" />
          <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximizar"
                  WindowChrome.IsHitTestVisibleInChrome="True" Click="OnToggleMaximize" />
          <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Fechar"
                  WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="Host" Grid.Row="1" />
  </Grid>
</Window>
