# Modelo do deploy/.env (gere o seu com: sh gerar-env.sh api.seudominio.com midia.seudominio.com).
DOMINIO_API=api.seudominio.com
DOMINIO_MIDIA=midia.seudominio.com
POSTGRES_PASSWORD=troque-por-uma-senha-longa-aleatoria
REDIS_PASSWORD=troque-por-uma-senha-longa-aleatoria
# 32 bytes aleatórios em base64 (openssl rand -base64 32)
JWT_SIGNING_KEY=
LIVEKIT_API_KEY=dinochave
# 32+ caracteres aleatórios
LIVEKIT_API_SECRET=
# Conexão garantida (TURN): 32+ caracteres aleatórios
TURN_SECRET=
# Só atrás de NAT 1:1 (AWS, GCP): o IP público do servidor. Vazio: descobre sozinho
TURN_IP_EXTERNO=
# false: só o comando "users add" cria contas
CADASTRO_ABERTO=true
# Se preenchido (12+ caracteres), o cadastro pelo app exige este código
CODIGO_CADASTRO=
API_REPLICAS=2
